{
	"productName": "GitButler 中文版",
	"identifier": "com.gitbutler.app.zhcn",
	"build": {
		"beforeBuildCommand": "bash ./crates/gitbutler-tauri/tauri-before-build-command.sh production"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/release/32x32.png",
			"icons/release/128x128.png",
			"icons/release/128x128@2x.png",
			"icons/release/icon.icns",
			"icons/release/icon.ico"
		],
		"externalBin": [
			"gitbutler-git-askpass",
			"but"
		],
		"targets": [
			"msi"
		],
		"createUpdaterArtifacts": false,
		"windows": {
			"wix": {
				"language": "zh-CN"
			}
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://127.0.0.1:9/zh-cn-no-updates.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwNTc2RDhBM0U0MjM4RUIKUldUck9FSStpbTFYWUE5UkJ3eXhuekZOL2V2RnpKaFUxbGJRNzBMVmF5V0gzV1JvN3hRblJMRDIK"
		},
		"deep-link": {
			"desktop": {
				"schemes": [
					"but"
				]
			}
		}
	},
	"version": "0.23.1"
}
